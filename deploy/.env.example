# Copy to deploy/.env on the server (chmod 600). Never commit the real file.
# Values below marked REQUIRED stop `docker compose` from starting without them.

# ── Release ─────────────────────────────────────────────────────────────
RELEASE=1.0.0

# ── Domains (DNS must point at this server before first start) ───────────
APP_DOMAIN=app.example.co.ke          # REQUIRED web app
API_DOMAIN=api.example.co.ke          # REQUIRED mobile API + callbacks
ACME_EMAIL=ops@example.co.ke          # REQUIRED certificate expiry notices

# ── Database ────────────────────────────────────────────────────────────
POSTGRES_DB=rentmanager
POSTGRES_USER=rentmanager
POSTGRES_PASSWORD=                    # REQUIRED  openssl rand -hex 24

# ── Secrets you generate (REQUIRED; back these up somewhere safe) ─────────
JWT_SECRET=                           # openssl rand -hex 32
# Encrypts landlords' Daraja credentials at rest. Losing it makes them
# unreadable; changing it breaks them. Generate once, store in a password manager.
DARAJA_CREDENTIALS_ENCRYPTION_KEY=    # openssl rand -base64 32

# ── Clerk (REQUIRED — nobody can sign in without it) ─────────────────────
CLERK_PUBLISHABLE_KEY=                # pk_test_… for staging, pk_live_… at launch
CLERK_SECRET_KEY=                     # sk_…
CLERK_JWKS_URL=                       # https://<frontend-api-host>/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=                 # whsec_… for https://API_DOMAIN/api/v1/webhooks/clerk
CLERK_WEB_WEBHOOK_SIGNING_SECRET=     # whsec_… for https://APP_DOMAIN/api/webhooks/clerk (if used)

# ── Providers: configure later (each feature fails closed until set) ─────
# M-Pesa. The secret authenticates Safaricom's callbacks: openssl rand -hex 24
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORT_CODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_SECRET=
# Each ends with the callback secret as the last path segment:
# DARAJA_RENT_PAYMENT_CALLBACK_URL=https://API_DOMAIN/api/v1/public/rent-ledger/mpesa/callback/<DARAJA_CALLBACK_SECRET>
# DARAJA_CALLBACK_URL=https://API_DOMAIN/api/v1/public/reservations/mpesa/callback/<DARAJA_CALLBACK_SECRET>
# DARAJA_SUBSCRIPTION_BILLING_CALLBACK_URL=https://API_DOMAIN/api/v1/public/subscription-billing/mpesa/callback/<DARAJA_CALLBACK_SECRET>
DARAJA_CALLBACK_URL=
DARAJA_RENT_PAYMENT_CALLBACK_URL=
DARAJA_SUBSCRIPTION_BILLING_CALLBACK_URL=
DARAJA_RATIBA_CALLBACK_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AT_ENABLED=false
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=
AT_BASE_URL=https://api.sandbox.africastalking.com/version1/messaging

NOTIFICATION_EMAIL_ENABLED=false
PUSH_EXPO_ACCESS_TOKEN=
WEB_SENTRY_DSN=

# ── Mobile app version gate ─────────────────────────────────────────────
MOBILE_MINIMUM_VERSION=1.0.0
MOBILE_LATEST_VERSION=1.0.0
MOBILE_ANDROID_STORE_URL=
MOBILE_IOS_STORE_URL=

# ── Host sizing ─────────────────────────────────────────────────────────
# Defaults suit a 4 GB server. For Oracle Cloud Always Free (A1, 2 OCPU /
# 12 GB) use the ORACLE block instead: a pre-touched 3 GB heap and a 1 GB
# Postgres cache give better performance AND keep memory use above 20%, so
# Oracle does not reclaim the instance as idle (it reclaims when CPU, network
# and memory all stay below 20% for 7 days).
BACKEND_MEMORY=1536m
WEB_MEMORY=512m
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
BACKEND_JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
# ORACLE (uncomment, and delete the four lines above):
# BACKEND_MEMORY=4g
# WEB_MEMORY=768m
# PG_SHARED_BUFFERS=1GB
# PG_EFFECTIVE_CACHE_SIZE=3GB
# BACKEND_JAVA_OPTS=-Xms3g -Xmx3g -XX:+AlwaysPreTouch -XX:+ExitOnOutOfMemoryError
BACKUP_RETENTION_DAYS=14
